{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C#: API Debug (Local)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/API/API.csproj"
    },
    {
      "name": "Docker: Attach to API Container",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}", //choose API.dll or dotnet
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": ["exec", "-i", "api-cqrs-clean-net9-dev"],
        "debuggerPath": "/vsdbg/vsdbg",
        "pipeCwd": "${workspaceFolder}",
        "quoteArgs": false
      },
      "sourceFileMap": {
        "/src": "${workspaceFolder}"
      }
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
