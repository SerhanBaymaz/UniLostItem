{
  "info": {
    "name": "UniLostItem API",
    "description": "Postman collection for UniLostItem API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"user@example.com\",\r\n  \"password\": \"Password123!\",\r\n  \"firstName\": \"John\",\r\n  \"lastName\": \"Doe\",\r\n  \"phoneNumber\": \"+1234567890\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if(jsonData && jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.accessToken);",
                  "    console.log(\"Token automatically updated.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"user@example.com\",\r\n  \"password\": \"Password123!\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"accessToken\": \"string\",\r\n  \"refreshToken\": \"string\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh-token"
              ]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "profile"
              ]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"firstName\": \"John\",\r\n  \"lastName\": \"Doe\",\r\n  \"phoneNumber\": \"+0987654321\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "profile"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Lost Items",
      "item": [
        {
          "name": "Get Items",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items?pageNumber=1&pageSize=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ],
              "query": [
                {
                  "key": "pageNumber",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "searchTerm",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "itemType",
                  "value": "Lost",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "Electronics",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Item Details",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "ITEM_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Get My Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/my-items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "my-items"
              ]
            }
          }
        },
        {
          "name": "Create Item",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"title\": \"Lost iPhone 14\",\r\n  \"description\": \"Black case, screen has a small scratch\",\r\n  \"category\": \"Electronics\",\r\n  \"itemType\": \"Lost\",\r\n  \"incidentDate\": \"2026-05-05T12:00:00Z\",\r\n  \"imageUrl\": \"\",\r\n  \"contactInfo\": \"user@example.com\",\r\n  \"locationLabel\": \"Library 2nd Floor\",\r\n  \"latitude\": 41.0082,\r\n  \"longitude\": 28.9784\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ]
            }
          }
        },
        {
          "name": "Update Item",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"title\": \"Lost iPhone 14 (Updated)\",\r\n  \"description\": \"Black case, updated description\",\r\n  \"category\": \"Electronics\",\r\n  \"incidentDate\": \"2026-05-05T12:00:00Z\",\r\n  \"imageUrl\": \"\",\r\n  \"contactInfo\": \"user@example.com\",\r\n  \"locationLabel\": \"Library 2nd Floor\",\r\n  \"latitude\": 41.0082,\r\n  \"longitude\": 28.9784\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/items/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "ITEM_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "ITEM_ID_HERE"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Item Claims",
      "item": [
        {
          "name": "Get Claims By Item",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/claims/by-item/:lostItemId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "by-item",
                ":lostItemId"
              ],
              "variable": [
                {
                  "key": "lostItemId",
                  "value": "ITEM_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Get My Claims",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/claims/my-claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "my-claims"
              ]
            }
          }
        },
        {
          "name": "Get Claim Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/claims/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "CLAIM_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Get Pending Claims (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/claims/pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                "pending"
              ]
            }
          }
        },
        {
          "name": "Create Claim",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"lostItemId\": \"ITEM_ID_HERE\",\r\n  \"description\": \"I think this is my phone, here are more details...\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims"
              ]
            }
          }
        },
        {
          "name": "Cancel Claim",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/claims/:id/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                ":id",
                "cancel"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "CLAIM_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Respond to Claim",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"isApproved\": true,\r\n  \"comment\": \"Matches my description, please contact me.\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/claims/:id/respond",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                ":id",
                "respond"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "CLAIM_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Extend Claim Deadline",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/claims/:id/extend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                ":id",
                "extend"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "CLAIM_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Admin Review Claim",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"isApproved\": true,\r\n  \"comment\": \"Approved by system admin.\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/claims/:id/admin-review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "claims",
                ":id",
                "admin-review"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "CLAIM_ID_HERE"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}